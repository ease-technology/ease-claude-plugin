#!/usr/bin/env python3
"""Launcher so the skill can run the engine without installing anything."""
import json
import sys

# The engine uses `X | None` syntax, which needs Python 3.10+. Keep this file
# 3.9-safe so the check can run (and report cleanly) on older interpreters.
if sys.version_info < (3, 10):
    found = "%d.%d" % sys.version_info[:2]
    print(json.dumps({"error": "ease needs Python 3.10 or newer (python3 here is %s)" % found}))
    sys.exit(1)

from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from engine.cli import main  # noqa: E402

sys.exit(main())
